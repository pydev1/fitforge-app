{
  "expo": {
    "name": "FitForge",
    "slug": "fitforge-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15171B",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#15171B"
    },
    "android": {
      "package": "com.fitforge.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15171B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FitForge needs photo access to analyse your exercise form and body composition.",
          "cameraPermission": "FitForge needs camera access to analyse your exercise form and body composition."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0b6b2035-c179-42f8-90c1-27a80dda3481"
      }
    }
  }
}
